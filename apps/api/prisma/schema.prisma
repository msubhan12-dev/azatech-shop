// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  INITIAL
  ORDER_OUT
  CANCEL_RESTORE
  ADJUSTMENT
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated   Order[]
  stockAdjustments StockMovement[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Product {
  id                  BigInt   @id @default(autoincrement())
  productCode         String   @unique
  productName         String
  stock               Int      @default(0)
  reservedStock       Int      @default(0)
  price               Decimal  @db.Decimal(12, 2)
  lowStockThreshold   Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  orderItems         OrderItem[]
  stockMovements     StockMovement[]

  @@index([productCode])
  @@index([deletedAt])
  @@map("products")
}

model Customer {
  id              String   @id @default(uuid())
  customerName    String
  customerAddress String?
  gender          String?
  birthDate       DateTime?
  phone           String?
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  orders Order[]

  @@index([email])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

model Order {
  id              BigInt   @id @default(autoincrement())
  orderNumber     String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  createdBy       BigInt
  creator         User     @relation(fields: [createdBy], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal  @db.Decimal(14, 2)
  orderDate       DateTime @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           OrderItem[]
  statusHistories OrderStatusHistory[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([paidAt])
  @@map("orders")
}

model OrderItem {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  BigInt
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(14, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  reason    String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_histories")
}

model StockMovement {
  id             BigInt   @id @default(autoincrement())
  productId      BigInt
  product        Product  @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantityChange Int
  stockAfter     Int
  referenceType  String?
  referenceId    String?
  note           String?
  createdBy      BigInt
  user           User     @relation(fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  method    String
  path      String
  status    Int      @default(202) // 202 = processing
  response  String?  // JSON stringified response
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  action    String   // e.g., "CREATE_ORDER", "DELETE_PRODUCT", "STOCK_ADJUSTMENT", "CANCEL_ORDER"
  entityType String  // e.g., "order", "product", "stock"
  entityId  String   // e.g., order ID, product ID
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])
  oldValues String?  // JSON stringified
  newValues String?  // JSON stringified
  metadata  String?  // Additional context as JSON
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
